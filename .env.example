# PostgreSQL connection string. Keep the real value outside version control.
DATABASE_URL="postgresql://user:password@localhost:5432/mediabsence?schema=public"

# Auth.js secret. Generate a unique value per environment.
AUTH_SECRET=""

# IANA timezone used for attendance and date-only business rules.
BUSINESS_TIMEZONE="America/Argentina/Buenos_Aires"

# Required only when running the local seed command; never use it in production.
SEED_PASSWORD=""
